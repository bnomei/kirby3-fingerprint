{
    "name": "bnomei/kirby3-fingerprint",
    "type": "kirby-plugin",
    "version": "6.0.0",
    "description": "File Method and css/js helper to add cache-busting hash and optional Subresource Integrity to file",
    "license": "MIT",
    "authors": [
        {
            "name": "Bruno Meilick",
            "email": "b@bnomei.com"
        }
    ],
    "keywords": [
        "kirby",
        "kirby-cms",
        "kirby-plugin",
        "fingerprint",
        "hash",
        "cache-buster",
        "subresource-integrity",
        "manifest",
        "manifest-file",
        "json",
        "assets"
    ],
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php": "8.3.0"
        },
        "sort-packages": true,
        "allow-plugins": {
            "getkirby/composer-installer": true,
            "pestphp/pest-plugin": true
        }
    },
    "autoload": {
        "psr-4": {
            "Bnomei\\": "classes/"
        }
    },
    "require": {
        "php": ">=8.3",
        "getkirby/composer-installer": "^1.2"
    },
    "require-dev": {
        "getkirby/cms": "^6.0",
        "laravel/pint": "^1.13",
        "pestphp/pest": "^v3.5.1",
        "phpstan/phpstan": "^2.1"
    },
    "scripts": {
        "stan": "./vendor/bin/phpstan",
        "fix": "./vendor/bin/pint",
        "test": "./vendor/bin/pest --profile",
        "kirby": "@composer install"
    },
    "extra": {
        "kirby-cms-path": "tests/kirby"
    },
    "suggest": {
        "bnomei/kirby3-security-headers": "Let's make the web a saver place – sensible defaults included.",
        "diverently/laravel-mix-kirby": "Consider using this plugin instead if all your assets are versioned by laravel mix."
    }
}
